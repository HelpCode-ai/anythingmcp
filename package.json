{
  "name": "anythingmcp",
  "version": "0.12.0",
  "description": "Turn any REST/OpenAPI, SOAP/WSDL, GraphQL or SQL API into MCP tools for Claude, ChatGPT and Copilot, no code. 258 pre-built adapters for ERP, e-commerce and more (SAP Business One, Odoo, Xentral, JTL-Wawi, Shopware, WooCommerce, Amazon Seller). Self-hosted, open source (AGPL-3.0).",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=packages/backend",
    "dev:frontend": "npm run dev --workspace=packages/frontend",
    "build": "npm run build --workspace=packages/backend && npm run build --workspace=packages/frontend",
    "build:backend": "npm run build --workspace=packages/backend",
    "build:frontend": "npm run build --workspace=packages/frontend",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "adapter:new": "node scripts/adapter-new.mjs",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "db:migrate": "npm run db:migrate --workspace=packages/backend",
    "db:seed": "npm run db:seed --workspace=packages/backend"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/react": "^19.3.0",
    "concurrently": "^9.2.4"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "https-proxy-agent": "^7.0.6"
  },
  "overrides": {
    "rxjs": "7.8.1",
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.2"
  }
}
