                "OPEN",
                "PAID",
                "PARTIALLY_PAID",
                "CANCELED",
                "WITHHELD",
                "OFFER",
                "ORDER",
                "PLANNED",
                "RELEASED"
              ]
            },
            "description": "Statuses to include, e.g. [\"OPEN\"]."
          },
          "invoiceNumber": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Exact invoice numbers."
          },
          "externalId": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "External ids."
          },
          "categoryId": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Category ids."
          },
          "source": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Sources, e.g. LEXOFFICE, OPEN_API."
          },
          "contactName": {
            "type": "string",
            "description": "Exact contact name, case-insensitive."
          },
          "page": {
            "type": "integer",
            "minimum": 0,
            "description": "Page number, from 0."
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "description": "Items per page (default 50)."
          }
        },
        "required": [
          "invoiceTypeFilter"
        ]
      },
      "endpointMapping": {
        "method": "GET",
        "path": "/invoices",
        "queryParams": {
          "invoiceTypeFilter": "$invoiceTypeFilter",
