    {
      "name": "tidely_create_invoice",
      "description": "Create a sales or purchase invoice (or credit note) so it shows up in the cash flow forecast on its due date. Required: invoiceType, invoiceNumber, contactName, totalGrossAmount. Returns the invoice with its id.",
      "parameters": {
        "type": "object",
        "properties": {
          "invoiceType": {
            "type": "string",
            "enum": [
              "SALES_INVOICE",
              "SALES_CREDIT_NOTE",
              "PURCHASE_INVOICE",
              "PURCHASE_CREDIT_NOTE"
            ],
            "description": "Kind of invoice."
          },
          "invoiceNumber": {
            "type": "string",
            "description": "Invoice number."
          },
          "contactName": {
            "type": "string",
            "description": "Customer (sales) or supplier (purchase) name."
          },
          "totalGrossAmount": {
            "type": "number",
            "description": "Total amount including tax."
          },
          "invoiceDate": {
            "type": "string",
            "format": "date",
            "description": "Invoice date, YYYY-MM-DD."
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "description": "Due date, YYYY-MM-DD; drives when the invoice lands in the cash flow forecast."
          },
          "paidDate": {
            "type": "string",
            "format": "date",
            "description": "Payment date, YYYY-MM-DD."
          },
          "invoiceStatus": {
            "type": "string",
            "enum": [
              "DRAFT",
              "OPEN",
              "PAID",
              "PARTIALLY_PAID",
              "CANCELED",
              "WITHHELD",
              "OFFER",
              "ORDER",
              "PLANNED",
              "RELEASED"
            ],
            "description": "Invoice status."
          },
          "openAmount": {
            "type": "number",
            "description": "Amount still unpaid."
          },
          "note": {
            "type": "string",
            "description": "Description or notes."
          },
          "categoryId": {
            "type": "integer",
            "description": "Category id (tidely_list_categories)."
          },
          "externalId": {
            "type": "string",
            "description": "Your own id for the invoice, e.g. from the ERP."
          }
        },
        "required": [
          "invoiceType",
          "invoiceNumber",
          "contactName",
          "totalGrossAmount"
        ]
      },
      "endpointMapping": {
        "method": "POST",
        "path": "/invoices",
        "bodyMapping": {
