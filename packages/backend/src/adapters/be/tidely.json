      "description": "Check that the API key is valid; returns success and the name of the user the key belongs to. Use it first or when other calls fail with 401 or 403.",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "endpointMapping": {
        "method": "GET",
        "path": "/authentication/verify-auth"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
