    {
      "name": "tidely_create_plan",
      "description": "Add a planned value to the forecast: a one-time amount on a category in a scenario for a day, week or month (negative for expenses, positive for income). By default it adds to existing planned values of that period; replaceCurrentValuesForThePeriod true replaces them. Without a category it goes to uncategorized income or expenses; without a scenario to the base case.",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "description": "Name of the plan."
          },
          "amount": {
            "type": "number",
            "description": "Amount, negative for expenses."
          },
          "period": {
            "type": "string",
            "enum": [
              "DAILY",
              "WEEKLY",
              "MONTHLY"
            ],
            "description": "Period the value applies to."
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "YYYY-MM-DD; first day of the month for MONTHLY, first day of the week for WEEKLY."
          },
          "type": {
            "type": "string",
            "enum": [
              "ONE_TIME"
            ],
            "default": "ONE_TIME",
            "description": "Plan type; ONE_TIME is the only one."
          },
          "categoryId": {
            "type": "integer",
            "description": "Category id (must accept planned values)."
          },
          "categoryName": {
            "type": "string",
            "description": "Category path instead of the id, parts joined with ->."
          },
          "scenarioId": {
            "type": "integer",
            "description": "Scenario id. Default: base case."
          },
          "scenarioName": {
            "type": "string",
            "description": "Scenario name instead of the id."
          },
          "replaceCurrentValuesForThePeriod": {
            "type": "boolean",
            "description": "true replaces the existing planned values of the period."
          }
        },
        "required": [
          "name",
          "amount",
          "period",
          "date"
        ]
      },
      "endpointMapping": {
        "method": "POST",
        "path": "/plans",
        "bodyMapping": {
          "name": "$name",
          "amount": "$amount",
          "period": "$period",
          "date": "$date",
          "type": "$type",
          "categoryId": "$categoryId",
          "categoryName": "$categoryName",
          "scenarioId": "$scenarioId",
          "scenarioName": "$scenarioName",
          "replaceCurrentValuesForThePeriod": "$replaceCurrentValuesForThePeriod"
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
