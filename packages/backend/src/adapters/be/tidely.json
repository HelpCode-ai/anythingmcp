          "invoiceNumber": "$invoiceNumber",
          "externalId": "$externalId",
          "categoryId": "$categoryId",
          "source": "$source",
          "contactName": "$contactName",
          "page": "$page",
          "pageSize": "$pageSize"
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
