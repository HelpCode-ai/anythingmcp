    {
      "name": "tidely_get_cashflow",
      "description": "Get the cash flow of the company per period (month, week or day) for a scenario: for each period start date the opening and closing balances (actual, forecast, total, plan), open sales and purchase invoices, amounts per category, income and expense details, KPIs, plus overdraft and liquidity per period. Default: base scenario, monthly, 6 periods back and 18 ahead of today. Use it for liquidity questions and forecasts.",
      "parameters": {
        "type": "object",
        "properties": {
          "scenarioId": {
            "type": "integer",
            "description": "Scenario id (tidely_list_scenarios). Default: the base forecast."
          },
          "period": {
            "type": "string",
            "enum": [
              "MONTH",
              "WEEK",
              "DAY"
            ],
            "description": "Bucket size. Default MONTH."
          },
          "from": {
            "type": "string",
            "format": "date",
            "description": "First day of the first period (first of the month for MONTH, a Monday for WEEK), YYYY-MM-DD."
          },
          "to": {
            "type": "string",
            "format": "date",
            "description": "Last day of the last period (end of month for MONTH, a Sunday for WEEK), YYYY-MM-DD."
          }
        }
      },
      "endpointMapping": {
        "method": "GET",
        "path": "/cashflow",
        "queryParams": {
          "scenarioId": "$scenarioId",
          "period": "$period",
          "from": "$from",
          "to": "$to"
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
