      "parameters": {
        "type": "object",
        "properties": {
          "campaign_id": {
            "type": "string",
            "description": "campaignId (UUID)."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "Targets per page, 1 to 1000. Default 100."
          },
          "cursor": {
            "type": "string",
            "description": "nextCursor from the previous page."
          }
        },
        "required": [
          "campaign_id"
        ]
      },
      "endpointMapping": {
        "method": "GET",
        "path": "/v1/sponsored-product-ads/campaigns/{campaign_id}/targets",
        "queryParams": {
          "limit": "$limit",
          "cursor": "$cursor"
        }
      }
    },
    {
      "name": "otto_ads_get_target",
      "description": "Read one target (advertised SKU) of a campaign with its bid.",
      "parameters": {
        "type": "object",
        "properties": {
