    {
      "name": "otto_ads_create_campaign",
      "description": "Create a campaign. AUTOMATIC campaigns bid per target (SKU); MANUAL campaigns bid per keyword. Add SKUs afterwards with otto_ads_add_targets and, for MANUAL, keywords with otto_ads_add_keywords. Asynchronous: poll otto_ads_get_change_request with the returned requestId. Starts real advertising spend from startDate; confirm budget and dates with the user first.",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "1 to 250 characters; no $ § \" # * or parentheses, except a trailing (2)."
          },
          "campaign_type": {
            "type": "string",
            "enum": [
              "AUTOMATIC",
              "MANUAL"
            ],
            "description": "AUTOMATIC bids per target (SKU), MANUAL bids per keyword. Cannot be changed later."
          },
          "budget": {
            "type": "object",
            "description": "Euro cents: {\"amount\": 1000, \"currency\": \"EUR\"} = 10.00 EUR. Minimum amount 20.",
            "properties": {
              "amount": {
                "type": "integer",
                "minimum": 20
              },
              "currency": {
                "type": "string",
                "enum": [
                  "EUR"
                ]
              }
            },
            "required": [
              "amount",
              "currency"
            ]
          },
          "budget_type": {
            "type": "string",
            "enum": [
              "DAILY",
              "WEEKLY",
              "MONTHLY",
              "LIFETIME"
            ],
            "description": "Period the budget applies to. Cannot be changed later; LIFETIME needs an end_date."
          },
          "pacing": {
            "type": "string",
            "enum": [
              "ASAP",
              "EVEN"
            ],
            "description": "ASAP spends as fast as possible, EVEN spreads the budget over the period."
          },
          "start_date": {
            "type": "string",
            "description": "YYYY-MM-DD, today or later."
          },
          "end_date": {
            "type": "string",
            "description": "YYYY-MM-DD. Omit for an ongoing campaign; required for a LIFETIME budget."
          }
        },
        "required": [
          "name",
          "campaign_type",
          "budget",
          "budget_type",
          "pacing",
