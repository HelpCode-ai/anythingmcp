        ]
      },
      "endpointMapping": {
        "method": "GET",
        "path": "/v1/sponsored-product-ads/campaigns/{campaign_id}/targets/{target_id}"
      }
    },
    {
      "name": "otto_ads_list_keywords",
      "description": "List the keywords of one target: keywordId, keyword, matchType (EXACT, PHRASE, BROAD), keywordType (POSITIVE or NEGATIVE) and bid (euro cents, positive keywords only). Targets of AUTOMATIC campaigns can carry negative keywords too. Page with cursor = nextCursor.",
      "parameters": {
        "type": "object",
        "properties": {
          "campaign_id": {
            "type": "string",
            "description": "campaignId (UUID)."
          },
          "target_id": {
            "type": "string",
            "description": "targetId (UUID)."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "Keywords per page, 1 to 1000. Default 100."
          },
          "cursor": {
            "type": "string",
            "description": "nextCursor from the previous page."
          }
        },
        "required": [
          "campaign_id",
          "target_id"
        ]
      },
      "endpointMapping": {
        "method": "GET",
        "path": "/v1/sponsored-product-ads/campaigns/{campaign_id}/targets/{target_id}/keywords",
        "queryParams": {
          "limit": "$limit",
          "cursor": "$cursor"
        }
      }
    },
    {
      "name": "otto_ads_get_change_request",
      "description": "Status of an asynchronous write: PENDING, ACCEPTED or REJECTED. ACCEPTED lists the affected entityIds; REJECTED carries rejectionReason. Poll with a growing wait (1 s, 2 s, 4 s...) to avoid 429.",
      "parameters": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "description": "changeRequest.requestId (UUID) returned by a write."
          }
        },
        "required": [
          "request_id"
        ]
      },
      "endpointMapping": {
        "method": "GET",
        "path": "/v1/sponsored-product-ads/change-requests/{request_id}"
      }
    },
    {
      "name": "otto_ads_get_campaign_kpis",
      "description": "KPIs of one campaign for a date range: views, clicks, costs, attributed sales, ordered SKUs, click-through rate, cost per click and return on ad spend. Costs and sales are euro cents. At most the last 90 days, never today; without dates OTTO uses the last 7 days. A campaign without data in the range answers 404 \"Data not found\".",
      "parameters": {
        "type": "object",
        "properties": {
          "campaign_id": {
            "type": "string",
            "description": "campaignId (UUID)."
          },
          "from_date": {
            "type": "string",
            "description": "YYYY-MM-DD, within the last 90 days."
          },
          "to_date": {
            "type": "string",
            "description": "YYYY-MM-DD, yesterday at the latest."
          }
        },
        "required": [
          "campaign_id"
        ]
      },
      "endpointMapping": {
        "method": "GET",
        "path": "/v1/spa-reporting/campaign-performance",
        "queryParams": {
          "campaignId": "$campaign_id",
          "fromDate": "$from_date",
          "toDate": "$to_date"
        }
      }
    },
    {
      "name": "otto_ads_get_product_kpis",
      "description": "KPIs of one SKU inside one campaign for a date range, the same metrics as the campaign KPIs plus totalSalesSeller (attributed sales of other articles of the same brand). Euro cents; at most the last 90 days, never today; default the last 7 days.",
      "parameters": {
        "type": "object",
        "properties": {
          "campaign_id": {
            "type": "string",
            "description": "campaignId (UUID)."
          },
          "sku": {
            "type": "string",
            "description": "The advertised SKU, as in otto_ads_list_targets."
          },
          "from_date": {
            "type": "string",
            "description": "YYYY-MM-DD, within the last 90 days."
          },
          "to_date": {
            "type": "string",
            "description": "YYYY-MM-DD, yesterday at the latest."
          }
        },
        "required": [
          "campaign_id",
          "sku"
        ]
      },
      "endpointMapping": {
        "method": "GET",
        "path": "/v1/spa-reporting/product-performance",
        "queryParams": {
          "campaignId": "$campaign_id",
          "sku": "$sku",
          "fromDate": "$from_date",
          "toDate": "$to_date"
        }
      }
    },
    {
      "name": "otto_ads_request_campaign_report",
      "description": "Start a CSV campaign report across campaigns and days. Returns a reportId; poll otto_ads_get_report_status with report_type \"campaign\" until READY, then otto_ads_download_report. Does not change any campaign, but counts against OTTO's quota of 200 reports per 24 hours.",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "description": "A name for the report."
          },
          "from_date": {
            "type": "string",
            "description": "YYYY-MM-DD, within the last 90 days."
          },
          "to_date": {
            "type": "string",
            "description": "YYYY-MM-DD, yesterday at the latest."
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "TOTAL_VIEWS",
                "TOTAL_CLICKS",
                "TOTAL_COSTS",
                "TOTAL_SALES",
                "TOTAL_ORDERED_SKUS",
                "CAMPAIGN_ID",
                "EVENT_DATE_CET"
              ]
            },
            "description": "Columns of the CSV. TOTAL_COSTS and TOTAL_SALES are euro cents."
          },
          "group_by": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "EVENT_DATE_CET",
                "CAMPAIGN_ID"
              ]
            },
            "description": "Group rows by day and/or campaign."
          },
          "filters": {
            "type": "array",
            "description": "Optional filters, combined with AND, e.g. [{\"column\": \"CAMPAIGN_ID\", \"operator\": \"=\", \"value\": \"<uuid>\"}].",
            "items": {
              "type": "object",
              "properties": {
                "column": {
                  "type": "string",
                  "enum": [
                    "CAMPAIGN_ID",
                    "SKU"
                  ]
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "=",
                    "!=",
                    ">=",
                    "<=",
                    ">",
                    "<"
                  ]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "column",
                "operator",
                "value"
              ]
            }
          }
        },
        "required": [
          "name",
          "from_date",
          "to_date",
          "columns"
        ]
      },
      "endpointMapping": {
        "method": "POST",
        "path": "/v1/spa-reporting/campaign-performance",
        "bodyMapping": {
          "name": "$name",
          "fromDate": "$from_date",
          "toDate": "$to_date",
          "configuration": {
            "format": "CSV",
            "columns": "$columns",
            "groupBy": "$group_by",
            "filters": "$filters"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
