      "parameters": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "description": "Page number, starting at 0."
          },
          "size": {
            "type": "integer",
            "description": "Records per page, up to 200."
          }
        }
      },
      "endpointMapping": {
        "method": "GET",
        "path": "/branch",
        "queryParams": {
          "page": "$page",
          "size": "$size"
        }
      }
    },
