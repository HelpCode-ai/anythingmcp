    {
      "name": "phorest_check_availability",
      "description": "Find free appointment slots in a branch for one client's chosen services between two times. Returns start times with the staff, room and service schedule of each slot. Nothing is booked.",
      "parameters": {
        "type": "object",
        "properties": {
          "branch_id": {
            "type": "string",
            "description": "Branch id from phorest_list_branches."
          },
          "start_time": {
            "type": "string",
            "description": "Earliest start to consider, ISO 8601, e.g. 2026-10-08T09:00:00Z."
          },
          "end_time": {
            "type": "string",
            "description": "Latest time to consider, ISO 8601."
          },
          "service_selections": {
            "type": "array",
            "description": "Services to book: [{\"serviceId\": \"...\", \"staffId\": \"optional preferred staff\"}].",
            "items": {
              "type": "object"
            }
          },
          "client_id": {
            "type": "string",
            "description": "Client id, when the client is known."
          },
          "online_only": {
            "type": "boolean",
            "description": "true to consider only staff bookable online."
          }
        },
        "required": [
          "branch_id",
          "start_time",
          "end_time",
          "service_selections"
        ]
      },
      "endpointMapping": {
        "method": "POST",
        "path": "/branch/{branch_id}/appointments/availability",
        "bodyMapping": {
          "startTime": "$start_time",
          "endTime": "$end_time",
          "clientId": "$client_id",
          "isOnlineAvailability": "$online_only",
          "clientServiceSelections": [
            {
              "clientId": "$client_id",
              "serviceSelections": "$service_selections"
            }
          ]
        }
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
