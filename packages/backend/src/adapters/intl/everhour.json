    {
      "name": "everhour_add_time",
      "description": "Log time on a task for a day (adds to what is already there). time is in seconds: 1 h 30 min is 5400. Without user it is logged for the key's owner; admins can log for others. Before calling, show the user exactly what will be recorded and confirm with the user first; wait for their yes.",
      "parameters": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "description": "Task id with its platform prefix, e.g. ev:3000010034, from everhour_search_tasks or everhour_list_project_tasks."
          },
          "date": {
            "type": "string",
            "description": "Day worked, YYYY-MM-DD. Default today."
          },
          "time": {
            "type": "integer",
            "minimum": 1,
            "description": "Time in seconds, e.g. 3600 for one hour."
          },
          "user_id": {
            "type": "integer",
            "description": "User to log the time for. Default: the key owner."
          },
          "comment": {
            "type": "string",
            "description": "Note on the time record."
          }
        },
        "required": [
          "task_id",
          "time"
        ]
      },
      "endpointMapping": {
        "method": "POST",
        "path": "/time",
        "bodyMapping": {
          "task": "$task_id",
          "date": "$date",
          "time": "$time",
          "user": "$user_id",
          "comment": "$comment"
        }
      },
      "responseMapping": {
        "transform": {
          "mode": "select",
          "select": {
            "id": "$.id",
            "date": "$.date",
            "time": "$.time",
            "user": "$.user",
            "comment": "$.comment",
            "taskId": "$.task.id",
            "taskName": "$.task.name",
            "isLocked": "$.isLocked",
            "isInvoiced": "$.isInvoiced",
            "lockReasons": "$.lockReasons",
            "warning": "$.warning"
          },
          "maxBytes": 5000
        }
      }
    },
    {
      "name": "everhour_update_time_record",
      "description": "Change one time record: set its time (seconds), and optionally its date, task, user or comment. Locked or invoiced records may be refused. Before calling, show the user exactly what will be recorded and confirm with the user first; wait for their yes.",
      "parameters": {
        "type": "object",
        "properties": {
          "time_id": {
            "type": "integer",
            "description": "Time record id from a time records list."
          },
          "date": {
            "type": "string",
            "description": "Move the record to this day, YYYY-MM-DD."
          },
          "time": {
            "type": "integer",
            "minimum": 1,
            "description": "Time in seconds. Required by Everhour: send the current value when only the comment or date changes."
          },
          "task_id": {
            "type": "string",
            "description": "Task id with its platform prefix, e.g. ev:3000010034, from everhour_search_tasks or everhour_list_project_tasks."
          },
          "user_id": {
            "type": "integer",
            "description": "User of the record."
          },
          "comment": {
