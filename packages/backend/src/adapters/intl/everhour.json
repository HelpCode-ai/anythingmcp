      "apiKey": "{{EVERHOUR_API_KEY}}"
    },
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json",
      "X-Accept-Version": "1.2",
      "User-Agent": "AnythingMCP"
    },
    "healthcheckPath": "/users/me"
  },
