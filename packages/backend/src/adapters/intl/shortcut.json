    {
      "name": "shortcut_list_epics",
      "description": "List epics page by page: id, name, state (to do, in progress, done), dates, owners, teams, objectives and story counts. Descriptions are left out unless includes_description is true. More: call again with page = next while next is a number; total is the number of epics.",
      "parameters": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "description": "Page number, starting at 1.",
            "minimum": 1,
            "default": 1
          },
          "page_size": {
            "type": "integer",
            "description": "Epics per page, 1 to 250. Default 25 here.",
            "minimum": 1,
            "maximum": 250,
            "default": 25
          },
          "includes_description": {
            "type": "boolean",
            "description": "Include each epic's description. Default false."
          }
        }
      },
      "endpointMapping": {
        "method": "GET",
        "path": "/epics/paginated",
        "queryParams": {
          "page": "$page",
          "page_size": "$page_size",
          "includes_description": "$includes_description"
        }
      },
      "responseMapping": {
        "transform": {
          "select": {
            "epics": {
              "$from": "$.data[*]",
              "$select": {
                "id": "id",
                "name": "name",
                "state": "state",
                "epic_state_id": "epic_state_id",
                "started": "started",
                "completed": "completed",
                "deadline": "deadline",
                "planned_start_date": "planned_start_date",
                "owner_ids": "owner_ids",
                "group_ids": "group_ids",
                "objective_ids": "objective_ids",
                "app_url": "app_url",
                "updated_at": "updated_at",
                "description": "description",
                "num_stories_total": "stats.num_stories_total",
                "num_stories_done": "stats.num_stories_done",
                "num_points": "stats.num_points",
                "num_points_done": "stats.num_points_done"
              }
            },
            "next": "$.next",
            "total": "$.total"
          },
          "maxBytes": 60000
        }
      }
    },
    {
      "name": "shortcut_search_epics",
      "description": "Search epics with text and Shortcut search operators (see the connector instructions), e.g. 'checkout is:started'. Returns up to page_size epics with id, name, state, dates and owners. More: pass the next token.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Words and operators, e.g. 'team:Mobile !is:done'.",
            "minLength": 1
          },
          "page_size": {
            "type": "integer",
            "description": "Results per page, 1 to 250. Default 25.",
            "minimum": 1,
            "maximum": 250,
            "default": 25
          },
          "next": {
            "type": "string",
            "description": "Token for the next page: the value after next= in the previous answer's next."
          }
        },
        "required": [
          "query"
        ]
      },
      "endpointMapping": {
        "method": "GET",
        "path": "/search/epics",
        "queryParams": {
          "query": "$query",
          "page_size": "$page_size",
          "next": "$next",
          "detail": "slim"
        }
      },
      "responseMapping": {
        "transform": {
          "select": {
            "epics": {
              "$from": "$.data[*]",
              "$select": {
                "id": "id",
                "name": "name",
                "state": "state",
                "epic_state_id": "epic_state_id",
                "started": "started",
                "completed": "completed",
                "deadline": "deadline",
                "planned_start_date": "planned_start_date",
                "owner_ids": "owner_ids",
                "group_ids": "group_ids",
                "objective_ids": "objective_ids",
                "app_url": "app_url",
                "updated_at": "updated_at"
              }
            },
            "total": "$.total",
            "next": "$.next"
          },
          "maxBytes": 60000
        }
      }
    },
    {
      "name": "shortcut_get_epic",
