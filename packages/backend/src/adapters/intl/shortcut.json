        "required": [
          "epic_id"
        ]
      },
      "endpointMapping": {
        "method": "GET",
        "path": "/epics/{epic_id}",
        "encodePathParams": true
      },
      "responseMapping": {
        "transform": {
          "select": {
            "id": "$.id",
            "name": "$.name",
            "state": "$.state",
            "epic_state_id": "$.epic_state_id",
            "started": "$.started",
            "completed": "$.completed",
            "deadline": "$.deadline",
            "planned_start_date": "$.planned_start_date",
            "owner_ids": "$.owner_ids",
            "group_ids": "$.group_ids",
            "objective_ids": "$.objective_ids",
            "app_url": "$.app_url",
            "updated_at": "$.updated_at",
            "description": "$.description",
            "labels": "$.labels[*].name",
            "health": "$.health.status",
            "stats": "$.stats",
            "comments": {
              "$from": "$.comments[*]",
