    {
      "name": "yandex_direct_get_report",
      "description": "Run a statistics report (Reports service) and return it as tab-separated text: a column header row, one row per line, money as decimals in the account currency. Common: CAMPAIGN_PERFORMANCE_REPORT with Date, CampaignName, Impressions, Clicks, Ctr, Cost, AvgCpc, Conversions; SEARCH_QUERY_PERFORMANCE_REPORT for search terms (offline only); CUSTOM_REPORT for any combination. If the answer is empty and the retryin header is set (HTTP 201 or 202), the report is being built offline: call again with exactly the same parameters and report_name after that many seconds. Read-only, free apart from API points.",
      "parameters": {
        "type": "object",
        "properties": {
          "report_name": {
            "type": "string",
            "maxLength": 255,
            "description": "A name unique for this set of parameters, e.g. campaigns-2026-10-01-2026-10-18. Reuse it only to poll the same report."
          },
          "report_type": {
            "type": "string",
            "enum": [
              "ACCOUNT_PERFORMANCE_REPORT",
              "CAMPAIGN_PERFORMANCE_REPORT",
              "ADGROUP_PERFORMANCE_REPORT",
              "AD_PERFORMANCE_REPORT",
              "CRITERIA_PERFORMANCE_REPORT",
              "CUSTOM_REPORT",
              "SEARCH_QUERY_PERFORMANCE_REPORT",
              "REACH_AND_FREQUENCY_PERFORMANCE_REPORT"
            ],
            "default": "CAMPAIGN_PERFORMANCE_REPORT",
            "description": "Report type. Default CAMPAIGN_PERFORMANCE_REPORT."
          },
          "date_range_type": {
            "type": "string",
            "enum": [
              "TODAY",
              "YESTERDAY",
              "LAST_3_DAYS",
              "LAST_5_DAYS",
              "LAST_7_DAYS",
              "LAST_14_DAYS",
              "LAST_30_DAYS",
              "LAST_90_DAYS",
              "LAST_365_DAYS",
              "THIS_WEEK_MON_TODAY",
              "LAST_WEEK",
              "LAST_BUSINESS_WEEK",
              "THIS_MONTH",
              "LAST_MONTH",
              "ALL_TIME",
              "CUSTOM_DATE",
              "AUTO"
            ],
            "default": "LAST_7_DAYS",
            "description": "Period. CUSTOM_DATE needs date_from and date_to; other values forbid them. Default LAST_7_DAYS."
          },
          "date_from": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "With CUSTOM_DATE: first day, YYYY-MM-DD."
          },
          "date_to": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "With CUSTOM_DATE: last day, YYYY-MM-DD."
          },
          "field_names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "Date",
              "CampaignId",
              "CampaignName",
              "Impressions",
              "Clicks",
              "Ctr",
              "Cost",
              "AvgCpc"
            ],
            "description": "Columns, e.g. Date, CampaignId, CampaignName, AdGroupName, Criterion, Query, Device, LocationOfPresenceName, Impressions, Clicks, Ctr, Cost, AvgCpc, Conversions, CostPerConversion, ConversionRate, Revenue, Bounces. Not every column exists in every report type."
          },
          "filter": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Optional filters: [{\"Field\":\"CampaignId\",\"Operator\":\"IN\",\"Values\":[\"123\"]}]. Operators EQUALS, NOT_EQUALS, IN, NOT_IN, LESS_THAN, GREATER_THAN, STARTS_WITH_IGNORE_CASE ... Money values in micros."
          },
          "goals": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional Metrica goal ids (at most 10) for Conversions columns."
          },
          "attribution_models": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "FC",
                "LC",
                "LSC",
                "LYDC",
                "FCCD",
                "LSCCD",
                "LYDCCD",
                "AUTO"
              ]
            },
            "description": "Optional attribution models for conversions."
          },
          "order_by": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Optional sort: [{\"Field\":\"Clicks\",\"SortOrder\":\"DESCENDING\"}]."
          },
          "include_vat": {
            "type": "string",
            "enum": [
              "YES",
              "NO"
            ],
            "default": "YES",
            "description": "Money with VAT (YES, default) or without."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000,
            "default": 1000,
            "description": "Maximum rows. Default 1000."
          },
          "processing_mode": {
            "type": "string",
            "enum": [
              "auto",
              "online",
              "offline"
            ],
            "default": "auto",
            "description": "auto (default) lets Yandex decide; offline always queues."
          }
        },
        "required": [
          "report_name"
        ]
      },
      "endpointMapping": {
        "method": "POST",
        "path": "/reports",
        "headers": {
          "Client-Login": "${YANDEX_DIRECT_CLIENT_LOGIN}",
          "processingMode": "$processing_mode",
          "returnMoneyInMicros": "false",
          "skipReportHeader": "true",
          "skipReportSummary": "true",
          "Accept": "text/tab-separated-values, application/json"
        },
        "exposeHeaders": [
          "retryin",
          "reportsinqueue"
        ],
        "bodyMapping": {
          "params": {
            "SelectionCriteria": {
              "DateFrom": "$date_from",
              "DateTo": "$date_to",
              "Filter": "$filter"
            },
            "Goals": "$goals",
            "AttributionModels": "$attribution_models",
            "FieldNames": "$field_names",
            "OrderBy": "$order_by",
            "Page": {
              "Limit": "$limit"
            },
            "ReportName": "$report_name",
            "ReportType": "$report_type",
            "DateRangeType": "$date_range_type",
            "Format": "TSV",
            "IncludeVAT": "$include_vat"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      }
    }
  ]
}
