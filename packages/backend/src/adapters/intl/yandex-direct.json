    {
      "name": "yandex_direct_list_sitelinks",
      "description": "Read sitelink sets by id (SitelinkSetId from yandex_direct_list_ads): each sitelink's Title, Href and Description. Read-only.",
      "parameters": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Sitelink set ids."
          },
          "sitelink_field_names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Fields of each sitelink.",
            "default": [
              "Title",
              "Href",
              "Description"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "default": 500,
            "description": "Objects per page, at most 10000. Default 500. When the answer has LimitedBy, there are more: pass it as offset."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "Skip this many objects (the LimitedBy value of the previous page)."
          }
        },
        "required": [
          "ids"
        ]
