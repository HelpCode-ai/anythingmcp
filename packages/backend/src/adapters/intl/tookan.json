          "pickup_delivery_relationship": "$pickup_delivery_relationship"
        }
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "tookan_list_agents",
      "description": "List agents (drivers, field staff, called fleets in the API): fleet_id, name, username, email, phone, status (0 available, 1 offline, 2 busy), is_available, is_active, last location and time, battery level, transport type, tags, team, fleet_type (1 captive, 2 freelancer). Read-only.",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Only agents with this name."
          },
          "tags": {
            "type": "string",
            "description": "Comma-separated tags."
          },
          "include_any_tag": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "1 matches agents with any of the tags, 0 with all of them."
          },
          "status": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "0 free, 1 busy."
          },
          "fleet_type": {
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "description": "1 captive, 2 freelancer."
          },
          "fleet_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Only these agent ids."
          },
          "include_team_id": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "1 adds the agent's team ids."
          }
        }
      },
      "endpointMapping": {
        "method": "POST",
        "path": "/get_all_fleets",
        "bodyMapping": {
          "api_key": "{{TOOKAN_API_KEY}}",
          "name": "$name",
          "tags": "$tags",
          "include_any_tag": "$include_any_tag",
          "status": "$status",
          "fleet_type": "$fleet_type",
          "fleet_ids": "$fleet_ids",
          "include_team_id": "$include_team_id"
        }
      },
      "responseMapping": {
        "transform": {
          "exclude": [
            "data[*].access_token",
            "data[*].password",
            "data[*].device_token",
            "data[*].app_access_token",
            "data[*].otp"
          ]
        }
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
