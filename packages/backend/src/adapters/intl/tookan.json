    {
      "name": "tookan_create_task",
      "description": "Create a task. Choose the kind with layout_type, has_pickup and has_delivery: pickup only (0, 1, 0), delivery only (0, 0, 1), pickup and delivery (0, 1, 1), appointment (1, 0, 0), field workforce (2, 0, 0). Pickup needs job_pickup_address and job_pickup_datetime; delivery, appointment and field workforce need customer_address and job_delivery_datetime (appointment and field workforce also job_pickup_datetime as start). timezone is required. Returns job_id, job_hash and tracking links.",
      "parameters": {
        "type": "object",
        "properties": {
          "timezone": {
            "type": "integer",
            "minimum": -840,
            "maximum": 720,
            "description": "UTC offset in minutes with the sign inverted, as Tookan expects: India (UTC+5:30) = -330, Central Europe winter (UTC+1) = -60, New York winter (UTC-5) = 300."
          },
          "layout_type": {
            "type": "integer",
            "enum": [
              0,
              1,
              2
            ],
            "default": 0,
            "description": "Workflow: 0 pickup and delivery (default), 1 appointment, 2 field workforce."
          },
          "has_pickup": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "1 when the task has a pickup (layout_type 0 only)."
          },
          "has_delivery": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "1 when the task has a delivery (layout_type 0 only)."
          },
          "order_id": {
            "type": "string",
            "description": "Your own order id, to find the task later with tookan_get_tasks_by_order_id."
          },
          "job_description": {
            "type": "string",
            "description": "Description shown to the agent."
          },
          "team_id": {
            "type": "integer",
            "description": "Team id from tookan_list_teams."
          },
          "fleet_id": {
            "type": "integer",
            "description": "Agent id from tookan_list_agents, to assign the task directly."
          },
          "auto_assignment": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "1 lets Tookan auto-assign an agent."
          },
          "tags": {
            "type": "string",
            "description": "Comma-separated tags; auto-assignment then picks agents with these tags."
          },
          "tracking_link": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "default": 1,
            "description": "1 (default) returns a customer tracking link."
          },
          "notify": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "1 sends the customer notifications configured in Tookan."
          },
          "geofence": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
