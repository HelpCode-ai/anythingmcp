# AnythingMCP Cloud — Caddy.
#
# ── Blue/green ─────────────────────────────────────────────────────────────
# The app runs in two colours, backend-blue/frontend-blue and backend-green/
# frontend-green (docker-compose.cloud.yml); one serves at a time. WHICH one
# is not in this file: it is the word in /config/amcp-colour inside the Caddy
# container (the caddy_config volume), read once per request (the `vars`
# line at the top of the site) and matched on by the handlers below. deploy/cloud/release.sh switches colour by rewriting that
# one word, atomically — no config reload. A reload hands the listening
# socket from the old server to the new one, and a connection accepted in
# that instant can be closed unanswered: measured 2026-09-25, 3 dropped
# requests in 50 reloads at ~50 req/s. The file switch drops none, requests
# already on the old colour finish there, and Caddy's admin API still counts
# in-flight requests per colour (backend-blue:4000 and backend-green:4000 are
# separate upstreams), which is how the release knows when the old colour
# has drained. This file changes, and Caddy reloads, only when routes change.
#
# With no colour file (a fresh caddy_config volume) every app route answers
# 503 until release.sh has written one.
#
# Edit this file in the repository; the copy on the host is overwritten in
# place by every release that changes it (in place: the bind mount follows the
# inode, so a rename would leave Caddy reading the old file).

(backend) {
	@blue vars amcp_colour blue
	@green vars amcp_colour green
	handle @blue {
		reverse_proxy backend-blue:4000
	}
	handle @green {
		reverse_proxy backend-green:4000
	}
	handle {
		respond "No live release selected" 503
	}
}

(frontend) {
	@blue vars amcp_colour blue
	@green vars amcp_colour green
	handle @blue {
		reverse_proxy frontend-blue:3000
	}
	handle @green {
		reverse_proxy frontend-green:3000
	}
	handle {
		respond "No live release selected" 503
	}
}

{$DOMAIN} {
	# Read the colour ONCE per request; every matcher below compares this
	# value. Two matchers each reading the file could straddle a switch
	# (the first sees the old word, the second the new) and match neither:
	# the release test caught exactly that, one 503 in ~4000 requests.
	vars amcp_colour {file./config/amcp-colour}

	# Compress the backend's JSON. Next compresses its own pages, the backend
	# does not, and nothing here did: GET /api/adapters, the catalogue the
	# connector store loads, went out as 551 KB of raw JSON (Sentry
	# ANYTHINGMCP-CLOUD-FRONTEND-5, "Large HTTP payload"). JSON only, on
	# purpose: MCP streams text/event-stream, and a compressor in front of a
	# stream can hold events back until its buffer fills. Clients that do not
	# send Accept-Encoding still get plain JSON.
	encode {
		match {
			header Content-Type application/json*
		}
		zstd
		gzip
		minimum_length 1024
	}

	# ── Backend ────────────────────────────────────────────────────────────
	# This list must match the `rewrites()` in packages/frontend/next.config.ts.
	#
	# Until the containers were split, only five of these were here, and the
	# other eight — /auth, /sso, /authorize, /callback, /token, /register,
	# /userinfo — reached the backend by a route nobody had drawn: Caddy sent
	# them to the frontend, and Next's rewrites (baked at build time with
	# http://localhost:4000, so no runtime variable can redirect them) forwarded
	# them to the backend in the same container. Two containers have no shared
	# localhost. Every path the backend owns is routed here explicitly, so the
	# OAuth endpoints Claude and ChatGPT connect through never depend on which
	# process happens to be listening next door.
	handle /api/* {
		import backend
	}
	handle /health* {
		import backend
	}
	handle /mcp {
		import backend
	}
	handle /mcp/* {
		import backend
	}
	handle /.well-known/* {
		import backend
	}
	handle /auth/* {
		import backend
	}
	handle /sso/* {
		import backend
	}
	handle /authorize {
		import backend
	}
	handle /callback {
		import backend
	}
	handle /token {
		import backend
	}
	handle /register {
		import backend
	}
	handle /userinfo {
		import backend
	}

	# ── Sentry tunnel ──────────────────────────────────────────────────────
	# Browser error reports, forwarded by Next.js to Sentry (tunnelRoute in
	# next.config.ts). Next passes every request header on, and Sentry derives
	# a location from the client address even with IP storage off, so the
	# visitor's address is not given to it.
	handle /monitoring {
		@blue vars amcp_colour blue
		@green vars amcp_colour green
		handle @blue {
			reverse_proxy frontend-blue:3000 {
				header_up -X-Forwarded-For
				header_up -X-Real-IP
				header_up -Forwarded
			}
		}
		handle @green {
			reverse_proxy frontend-green:3000 {
				header_up -X-Forwarded-For
				header_up -X-Real-IP
				header_up -Forwarded
			}
		}
		handle {
			respond "No live release selected" 503
		}
	}

	# ── Frontend (Next.js) ─────────────────────────────────────────────────
	# Its own container: a backend restart leaves the app reachable, and the
	# frontend can never take the API down with it.
	handle {
		import frontend
	}
}
